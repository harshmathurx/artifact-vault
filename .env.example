# ── artifact-vault Environment Configuration ──
#
# Copy this file to `.env` and fill in your values.
# This file is committed to the repo as a reference; `.env` is gitignored.

# The base URL of your Vercel deployment.
# Used by deploy-artifact.js and ingest-incoming.js to output absolute artifact URLs.
# Example: https://my-vault.vercel.app
VERCEL_PROJECT_URL=https://your-project.vercel.app
